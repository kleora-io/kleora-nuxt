{
  "name": "@kleora-io/nuxt",
  "version": "0.1.0",
  "type": "module",
  "description": "Kleora Nuxt 4 module — composables, route middleware, the OAuth callback route and $kleoraApi over @kleora-io/browser.",
  "license": "Apache-2.0",
  "homepage": "https://kleora.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kleora-io/kleora-nuxt.git"
  },
  "bugs": {
    "url": "https://github.com/kleora-io/kleora-nuxt/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0",
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prepare": "nuxt-module-build build",
    "build": "nuxt-module-build build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2",
    "@kleora-io/browser": "^0.1.0",
    "defu": "^6.1.7",
    "ofetch": "^1.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@types/node": "^24.10.0",
    "eslint": "^10.0.0",
    "nuxt": "^4.5.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.2.0"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  }
}
